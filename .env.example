# Local-only settings. Generate your own secret: openssl rand -hex 32
DATABASE_URL=postgresql://calm:calm_local_password@localhost:5432/calm_corner
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SERVER_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_ADDRESS=hello@example.test
EMAIL_FROM_NAME=The Calm Corner
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=false

# Local media uses ./media; configure all of these for S3-compatible storage.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Optional monitoring. Set the same DSN for server/edge and browser if wanted.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Optional local seed credentials, never commit actual values.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
